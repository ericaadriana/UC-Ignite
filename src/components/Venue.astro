---
import { event } from "../data/event";

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${event.venue} ${event.city}`)}`;
---

<section id="venue" class="space-bg py-20 sm:py-24">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold tracking-widest text-ember">WHEN & WHERE</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">See you in Surabaya</h2>
      <dl class="mt-8 space-y-5">
        <div>
          <dt class="text-sm text-white/60">Date</dt>
          <dd class="mt-1 text-xl font-semibold text-white">{event.dates}</dd>
        </div>
        <div>
          <dt class="text-sm text-white/60">Venue</dt>
          <dd class="mt-1 text-xl font-semibold text-white">{event.venue}, {event.city}</dd>
        </div>
      </dl>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={event.registerUrl}
          target="_blank"
          rel="noopener"
          class="btn-fire rounded-full px-6 py-3 text-center font-semibold text-white transition hover:brightness-110"
        >Register now</a>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener"
          class="rounded-full px-6 py-3 text-center font-semibold text-white ring-1 ring-white/30 transition hover:bg-white/10"
        >Open in Google Maps</a>
      </div>
    </div>

    <a href="/images/poster.jpg" target="_blank" class="mx-auto block w-full max-w-sm" title="Open the full poster">
      <img
        src="/images/poster.jpg"
        alt="IGNITE 2026 event poster"
        class="w-full rounded-2xl shadow-2xl shadow-violet/30 ring-1 ring-white/15 transition hover:scale-[1.02]"
        width="1100"
        height="1556"
        loading="lazy"
      />
    </a>
  </div>
</section>
