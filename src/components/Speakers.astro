---
import { speakers } from "../data/event";
---

<section id="speakers" class="space-bg py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-sm font-semibold tracking-widest text-ember">SPEAKERS</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">Learn from the best</h2>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {speakers.map((s) => (
        <li class="flex flex-col overflow-hidden rounded-3xl bg-gradient-to-b from-royal/70 to-deep ring-1 ring-white/15 transition hover:-translate-y-1 hover:ring-ember/60">
          {/* Photos are cropped above the name label printed in the original design files. */}
          <img
            src={`/images/speakers/${s.photo}.webp`}
            alt={s.name}
            class="aspect-[3/2] w-full"
            width="720"
            height="480"
            loading="lazy"
          />
          <div class="flex-1 border-t border-white/10 bg-deep/80 p-5">
            <p class="font-semibold leading-snug text-white">{s.name}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-white/65">{s.role}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
