---
import { speakers } from "../data/event";
---

<section id="speakers" class="space-bg py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-sm font-semibold tracking-widest text-ember">SPEAKERS</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">Learn from the best</h2>
    </div>

    <div class="mt-12 overflow-hidden rounded-3xl ring-1 ring-white/15">
      <img
        src="/images/speakers.webp"
        alt="The seven IGNITE 2026 speakers"
        class="w-full"
        width="1300"
        height="688"
        loading="lazy"
      />
      <ul class="grid gap-x-8 gap-y-6 bg-gradient-to-r from-royal to-deep p-6 sm:grid-cols-2 sm:p-8 lg:grid-cols-4">
        {speakers.map((s) => (
          <li>
            <p class="font-semibold text-white">{s.name}</p>
            <p class="mt-1 text-sm italic text-white/65">{s.org}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
