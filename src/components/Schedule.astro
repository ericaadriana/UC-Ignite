---
import { schedule } from "../data/event";
---

<section id="schedule" class="bg-deep py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-sm font-semibold tracking-widest text-ember">SCHEDULE</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">Three days of IGNITE</h2>
      <p class="mt-4 text-white/70">All times in WIB (UTC+7). Schedule may change.</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {schedule.map((d) => (
        <div class="rounded-3xl bg-white/5 p-6 ring-1 ring-white/10">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="font-display text-2xl font-black text-fire">{d.day}</h3>
            <span class="text-sm font-semibold text-white/70">{d.date}</span>
          </div>
          <p class="mt-1 font-semibold text-white">{d.focus}</p>
          <ol class="mt-6 space-y-5 border-l border-white/15 pl-5">
            {d.items.map((it) => (
              <li class="relative">
                <span class="absolute -left-[1.6rem] top-1.5 h-2.5 w-2.5 rounded-full bg-flame ring-4 ring-deep"></span>
                <p class="text-sm font-semibold tabular-nums text-ember">{it.time}</p>
                <p class="mt-0.5 text-white">{it.title}</p>
                {it.note && <p class="mt-0.5 text-sm text-white/60">{it.note}</p>}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>
