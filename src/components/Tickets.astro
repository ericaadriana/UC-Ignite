---
import { event, passes } from "../data/event";
---

<section id="tickets" class="bg-deep py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <p class="text-sm font-semibold tracking-widest text-ember">ENTRY PASS</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">Get your pass</h2>
      <p class="mt-4 text-white/70">Prices in Indonesian Rupiah (IDR).</p>
    </div>

    <div class="mx-auto mt-12 grid max-w-3xl gap-6 sm:grid-cols-2">
      {passes.map((p) => (
        <div class:list={["relative rounded-3xl p-8 text-center", p.featured ? "border-fire shadow-2xl shadow-rose/20" : "bg-white/5 ring-1 ring-white/10"]}>
          {p.featured && (
            <span class="btn-fire absolute -top-3 left-1/2 -translate-x-1/2 rounded-full px-3 py-1 text-xs font-bold text-white">
              BEST VALUE
            </span>
          )}
          <h3 class="font-display text-lg font-bold text-white">{p.name}</h3>
          <p class="mt-4 font-display text-5xl font-black text-fire">{p.price}</p>
          <p class="mt-3 text-white/70">{p.note}</p>
          <a
            href={event.registerUrl}
            target="_blank"
            rel="noopener"
            class:list={[
              "mt-8 block rounded-full px-6 py-3 font-semibold text-white transition",
              p.featured ? "btn-fire hover:brightness-110" : "ring-1 ring-white/30 hover:bg-white/10",
            ]}
          >Register</a>
        </div>
      ))}
    </div>
  </div>
</section>
