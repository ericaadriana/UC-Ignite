---
import { event, pillars } from "../data/event";
---

<section id="about" class="bg-deep py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-widest text-ember">ABOUT THE EVENT</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">Building Beyond Borders</h2>
      <p class="mt-5 text-lg leading-relaxed text-white/75">
        {event.name} is Universitas Ciputra's celebration of Global Entrepreneurship Week. For three days,
        speakers from Universitas Ciputra, the National University of Singapore and young founders share
        how entrepreneurship, technology and connections can build a sustainable future.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {pillars.map((p) => (
        <div class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
          <div class="btn-fire flex h-12 w-12 items-center justify-center rounded-xl">
            <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d={p.icon}></path>
            </svg>
          </div>
          <h3 class="mt-5 font-display text-lg font-bold text-white">{p.title}</h3>
          <p class="mt-2 leading-relaxed text-white/70">{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
