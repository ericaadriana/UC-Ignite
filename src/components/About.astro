---
import { programs, stats } from "../data/event";
---

<section id="about" class="bg-deep py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-widest text-ember">ABOUT THE EVENT</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">Building Beyond Borders</h2>
      <p class="mt-5 text-lg leading-relaxed text-white/75">
        IGNITE is Universitas Ciputra's celebration of Global Entrepreneurship Week Indonesia. For three days,
        speakers from Universitas Ciputra, the National University of Singapore and young founders share
        how entrepreneurship, technology and connections can build a sustainable future.
      </p>
    </div>

    <dl class="mx-auto mt-12 grid max-w-4xl grid-cols-2 gap-4 sm:grid-cols-4">
      {stats.map((s) => (
        <div class="rounded-2xl bg-white/5 p-5 text-center ring-1 ring-white/10">
          <dd class="font-display text-3xl font-black text-fire sm:text-4xl">{s.value}</dd>
          <dt class="mt-1 text-sm text-white/65">{s.label}</dt>
        </div>
      ))}
    </dl>

    <h3 class="mt-16 text-center font-display text-2xl font-bold text-white">4 main programs</h3>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {programs.map((p) => (
        <div class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
          <div class="flex items-center justify-between">
            <div class="btn-fire flex h-12 w-12 items-center justify-center rounded-xl">
              <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d={p.icon}></path>
              </svg>
            </div>
            <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-ember">{p.days}</span>
          </div>
          <h4 class="mt-5 font-display text-lg font-bold text-white">{p.title}</h4>
          <p class="mt-2 leading-relaxed text-white/70">{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
