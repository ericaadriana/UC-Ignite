---
import { event } from "../data/event";
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-night py-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col items-center justify-between gap-8 md:flex-row">
      <div class="text-center md:text-left">
        <p class="font-display text-2xl font-black tracking-wider glow-title">IGNITE</p>
        <p class="mt-1 text-sm text-white/60">{event.fullName}</p>
      </div>

      <div class="flex items-center gap-4">
        <span class="text-xs font-semibold tracking-widest text-white/60">SPONSORED BY</span>
        <img src="/images/sponsor-como.webp" alt="COMO Air Mineral Mangosteen" class="h-16 w-auto rounded-xl ring-2 ring-white/70" width="100" height="110" loading="lazy" />
      </div>

      <a
        href={`https://instagram.com/${event.instagram}`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-white ring-1 ring-white/20 transition hover:bg-white/10"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
        @{event.instagram}
      </a>
    </div>

    <p class="mt-10 text-center text-xs text-white/40">© {year} Universitas Ciputra · {event.name}</p>
  </div>
</footer>
